rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "utsavsharma9714@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if (isOwner(userId) || isAdmin()) && request.resource.data.uid == userId;
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId);
      allow update: if isValidId(orderId);
      allow delete: if isAdmin();
    }

    // Custom Inquiries & Blueprints
    match /inquiries/{inquiryId} {
      allow read: if isValidId(inquiryId);
      allow create: if isValidId(inquiryId);
      allow update: if isValidId(inquiryId);
      allow delete: if isAdmin();
    }

    // Product Customer Reviews
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow create: if isSignedIn() && isValidId(reviewId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(reviewId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(reviewId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Product Alerts (Notify Me on Price Drop or Restock)
    match /product_alerts/{alertId} {
      allow read: if isValidId(alertId);
      allow create: if isValidId(alertId);
      allow update: if isValidId(alertId);
      allow delete: if isValidId(alertId);
    }
  }
}
