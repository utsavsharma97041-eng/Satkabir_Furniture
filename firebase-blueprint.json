{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Furniture store customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "totalAmount": { "type": "number" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "discountAmount": { "type": "number" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "paymentStatus": { "type": "string", "maxLength": 64 },
        "orderStatus": { "type": "string", "maxLength": 64 },
        "trackingUpdates": { "type": "array" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "createdAt", "totalAmount", "orderStatus"]
    },
    "CustomInquiry": {
      "title": "CustomInquiry",
      "description": "Customer bespoke furniture blueprint or modification inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerPhone": { "type": "string", "maxLength": 32 },
        "customerEmail": { "type": "string", "maxLength": 128 },
        "city": { "type": "string", "maxLength": 64 },
        "productType": { "type": "string", "maxLength": 128 },
        "woodPreference": { "type": "string", "maxLength": 128 },
        "finishPreference": { "type": "string", "maxLength": 128 },
        "approxDimensions": { "type": "string", "maxLength": 128 },
        "budgetInr": { "type": "number" },
        "referenceImageUrl": { "type": "string", "maxLength": 2048 },
        "description": { "type": "string", "maxLength": 4096 },
        "status": { "type": "string", "maxLength": 64 },
        "estimatedDeliveryDate": { "type": "string", "maxLength": 64 },
        "adminQuotedPrice": { "type": "number" },
        "adminNotes": { "type": "string", "maxLength": 2048 }
      },
      "required": ["id", "createdAt", "customerName", "customerPhone", "description", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "role": { "type": "string", "maxLength": 32 }
      },
      "required": ["uid", "email"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer ratings and textual feedback for specific furniture pieces",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userPhoto": { "type": "string", "maxLength": 2048 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 128 },
        "comment": { "type": "string", "maxLength": 2000 },
        "woodTypePurchased": { "type": "string", "maxLength": 128 },
        "verifiedBuyer": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "helpfulCount": { "type": "number" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/inquiries/{inquiryId}": {
      "schema": "CustomInquiry",
      "description": "Custom furniture modification requests"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product ratings and reviews"
    }
  }
}
